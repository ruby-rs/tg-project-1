# === Telegram ===
BOT_TOKEN=123456789:AA...

# === PostgreSQL (для docker compose) ===
POSTGRES_DB=foreman
POSTGRES_USER=foreman
POSTGRES_PASSWORD=change-me
# При запуске без Docker:
# DATABASE_URL=postgresql+asyncpg://foreman:change-me@localhost:5432/foreman

# === Общие ===
DEFAULT_TIMEZONE=Europe/Moscow
# Сообщения до этого часа относятся к предыдущему рабочему дню (0 — календарные сутки)
WORK_DAY_START_HOUR=0
LOG_LEVEL=INFO
# Ошибки в Sentry или GlitchTip (пусто — выключено)
SENTRY_DSN=

# === Персональные данные (152-ФЗ), см. docs/PERSONAL_DATA.md ===
# Оператор для текста согласия: наименование, ИНН, адрес
PD_OPERATOR=
PRIVACY_POLICY_URL=
# Куда писать для отзыва согласия и удаления данных
SUPPORT_CONTACT=

# === Расшифровка голосовых ===
# api   — OpenAI-совместимый /v1/audio/transcriptions (облако или свой сервер)
# local — faster-whisper внутри воркера (собрать образ с LOCAL_WHISPER=1)
TRANSCRIBER=local
LOCAL_WHISPER=1
# Модель: tiny | base | small | medium | large-v3 (точнее, но медленнее)
WHISPER_LOCAL_MODEL=small
# cpu | cuda; тип вычислений: int8 для CPU, float16 для GPU
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Для TRANSCRIBER=api:
# WHISPER_API_BASE_URL=http://whisper:8000/v1
# WHISPER_API_KEY=
# WHISPER_API_MODEL=whisper-1

# === LLM: любой OpenAI-совместимый API ===
# YandexGPT (Yandex Cloud AI Studio):
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_API_KEY=<API-ключ сервисного аккаунта>
# LLM_PROJECT=<ID каталога>
# LLM_MODEL=gpt://<ID каталога>/yandexgpt/latest
# Свой сервер (vLLM / Ollama) с открытой моделью:
LLM_BASE_URL=http://llm:8000/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
# Мультимодальная модель для описания фото (пусто — фото только с подписью)
LLM_VISION_MODEL=
# Выключить, если провайдер не поддерживает response_format=json_object
LLM_JSON_MODE=true

# === Воркер ===
WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=5
